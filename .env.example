# Copy to .env and fill in for LAN / real-hardware testing:
#   cp .env.example .env
# docker compose reads .env automatically; values here override the defaults
# baked into docker-compose.yml.

# --- HTTP API ---
# API key required on every bridge endpoint. The onboarding URL carries it as
# ?key=<API_KEY>. Change it from the dev default before any LAN test.
API_KEY=dev-integration-key

# Comma-separated RC Plus serial numbers allowed to onboard. Set this to your
# real controller's serial number; leave blank to allow any.
SN_ALLOWLIST=RC-MOCK-0001

# --- MQTT (device-facing) ---
# The broker host returned to the RC Plus during onboarding. For a LAN test
# this MUST be the bridge host's LAN IP, tcp:// scheme, port 1883 (plaintext).
# Do NOT use port 8883 — that is the TLS port and needs a trusted certificate.
#   example: MQTT_PUBLIC_HOST=tcp://192.168.1.50:1883
MQTT_PUBLIC_HOST=tcp://localhost:1883

# --- DJI developer credentials (required for real hardware) ---
# Obtained from the DJI developer site. platformVerifyLicense — and therefore
# the whole onboarding flow — fails without these.
DJI_APP_ID=
DJI_APP_KEY=
DJI_LICENSE=

# Workspace UUID (your tenant identifier).
WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- misc ---
LOG_LEVEL=info
